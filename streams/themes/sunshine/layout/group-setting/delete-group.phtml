<div class="page-margin mt-0">
	<div class="wow_content popular_posts_hdr">
		<h2>
			<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" ...></svg>
			&nbsp;<?php echo $wo['lang']['delete_group'];?>
		</h2>
	</div>
</div>
<div class="wo_settings_page wow_content">
    <div class="setting-delete-page-alert"></div>
    <div class="wow_form_fields">
        <label for="sdt_suffix">Secure Delete Token</label>
        <div style="display:flex;align-items:center;gap:8px">
            <span id="sdt_prefix">----</span>
            <input type="text" id="sdt_suffix" maxlength="5" placeholder="Enter suffix">
            <button type="button" id="send_code_btn" class="btn btn-main">Send SDT Code</button>
        </div>
        <div id="delete_info" style="margin-top:8px;"></div>
        <div id="cooldown_bar" style="margin-top:8px;height:20px;"></div>
    </div>
    <input type="hidden" id="delete_token">
    <input type="hidden" id="group_id" value="<?php echo $wo['setting']['id']; ?>">
    <div class="text-center" style="margin-top:15px;">
        <button type="button" id="delete_group_btn" class="btn btn-danger btn-mat-raised">Delete Group</button>
    </div>
</div>
<script>
(function(){
    const endpoint = "/streams/delete_group_endpoint.php";
    const groupId = document.getElementById('group_id').value;
    let currentToken = null;
    let cooldownTill = null;
    let cooldownInterval = null;
    function updateCooldown(sec){
        cooldownTill = Date.now() + sec*1000;
        updateCooldownBar();
        if(cooldownInterval) clearInterval(cooldownInterval);
        cooldownInterval = setInterval(updateCooldownBar, 500);
    }
    function updateCooldownBar(){
        const el = document.getElementById('cooldown_bar');
        if(!cooldownTill) { el.innerHTML=''; return; }
        let remain = Math.max(0, Math.ceil((cooldownTill-Date.now())/1000));
        el.innerHTML = remain>0 ? `<div style="background:linear-gradient(90deg,#ff4040,#ffe140,#40ffb0);height:18px;width:${Math.max(10,100-remain)}%;border-radius:7px;"></div> <small>Next code in ${remain}s</small>` : '';
        if(remain<=0 && cooldownInterval){ clearInterval(cooldownInterval); cooldownInterval=null; cooldownTill=null; }
    }
    document.getElementById('send_code_btn').addEventListener('click', async function(){
        if(cooldownTill && cooldownTill>Date.now()){ alert(`Wait ${(cooldownTill-Date.now())/1000|0}s`); return; }
        this.disabled=true;
        document.getElementById('delete_info').textContent='Sending...';
        const fd = new FormData();
        fd.append('action','send_code');
        fd.append('group_id',groupId);
        try{
            const res = await fetch(endpoint,{method:'POST',body:fd});
            const data = await res.json();
            if(data.status===200){
                currentToken=data.token;
                document.getElementById('delete_token').value=data.token;
                document.getElementById('sdt_prefix').textContent=data.prefix+"-";
                const expiry=new Date(data.expiry*1000);
                document.getElementById('delete_info').textContent=data.message+" Expires: "+expiry.toLocaleString();
                updateCooldown(data.next_cooldown_sec||60);
                alert(data.message);
            } else if(data.status===429){
                updateCooldown(data.next_cooldown_sec||60);
                document.getElementById('delete_info').textContent=data.message;
            } else { document.getElementById('delete_info').textContent=data.message; }
        } catch(e){ document.getElementById('delete_info').textContent='Error sending code'; }
        this.disabled=false;
    });
    document.getElementById('delete_group_btn').addEventListener('click', async function(){
        const suffix=document.getElementById('sdt_suffix').value.trim().toUpperCase();
        if(!currentToken){ return alert("Request a deletion code first."); }
        if(suffix.length!==5){ return alert("Enter 5-character suffix."); }
        const fd=new FormData();
        fd.append('action','confirm_delete');
        fd.append('group_id',groupId);
        fd.append('token',currentToken);
        fd.append('suffix',suffix);
        try{
            const res=await fetch(endpoint,{method:'POST',body:fd});
            const data=await res.json();
            if(data.status===200){
                alert(data.message);
                window.location.href="/index.php?link1=groups";
            } else {
                document.querySelector('.setting-delete-page-alert').innerHTML='<div class="alert alert-danger">'+data.message+'</div>';
            }
        } catch(e){
            document.querySelector('.setting-delete-page-alert').innerHTML='<div class="alert alert-danger">Error confirming deletion</div>';
        }
    });
})();
</script>